# Copie ce fichier en .env.local et remplis avec les valeurs de ton projet Supabase
# (Supabase > Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Clé secrète : ne jamais la partager ni la mettre dans le code.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Notifications push : cles generees avec  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-adresse@exemple.fr
